{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "types": ["@webgpu/types"]
  },
  "include": ["src"]
}
